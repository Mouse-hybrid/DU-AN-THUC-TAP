                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
                  "pm.test(\"Both menu items added\",()=>{const x=pm.response.json();pm.expect(x.id).to.eql(pm.environment.get(\"pa_order\"));const a=x.items.find(i=>i.menu_item_id===pm.environment.get(\"pa_menu\"));const b=x.items.find(i=>i.menu_item_id===pm.environment.get(\"qa_menu_second\"));pm.expect(a).to.exist;pm.expect(b).to.exist;pm.environment.set(\"pa_item\",a.id);pm.environment.set(\"qa_second_item\",b.id);});",
                  "if (!(pm.response.code===201)) {console.warn(\"BLOCKED: unexpected status at \"+pm.info.requestName);pm.execution.setNextRequest(null);}"
                ]
