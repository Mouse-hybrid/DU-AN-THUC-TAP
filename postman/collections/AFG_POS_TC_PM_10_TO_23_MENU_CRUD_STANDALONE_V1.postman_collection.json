{
  "info": {
    "name": "AFG POS QA | MENU CRUD TC_PM_10 to TC_PM_23 | STANDALONE RETEST V1",
    "_postman_id": "aeaae656-7508-4e0d-8878-0ff439da3f81",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run ONLY on approved QA staging; creates persistent Menu Category and item. Requires POS_STAGING password + qa_allow_persistent_menu_mutations=true. No cleanup deletion route verified. Partial TC_PM_19/20 coverage must not be recorded as full PASS. Other assertions are real, not forced PASS."
  },
  "item": [
    {
      "name": "01_TC_PM_10_TO_23_MENU_CRUD",
      "item": [
        {
          "name": "PREFLIGHT - MENU MUTATIONS PERMISSION (BLOCKED if not opted in)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "GATED by qa_allow_persistent_menu_mutations=true in POS_STAGING. The suite creates persistent category/menu items; when false, BLOCKED is expected and TC_PM_10–23 must remain NOT RUN. No silent PASS."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const raw=pm.environment.get(\"qa_allow_persistent_menu_mutations\");",
                  "const allowed=String(raw).trim().toLowerCase()===\"true\";",
                  "pm.test(\"PREFLIGHT /health HTTP 200\",function(){pm.response.to.have.status(200);});",
                  "pm.test(\"PREFLIGHT persistent Menu CRUD authorized (BLOCKED if unset)\",function(){pm.expect(allowed,\"Set POS_STAGING variable qa_allow_persistent_menu_mutations=true ONLY with authorization; new categories/menu items persist\").to.be.true;});",
                  "if(!allowed || pm.response.code!==200){pm.environment.set(\"qa_pm_block_reason\",\"BLOCKED_MENU_OPT_IN\");console.error(\"BLOCKED_MENU_OPT_IN: persistent CRUD not authorized or health failed; zero menu mutations executed. Do not report TC_PM_10-23 as FAIL or PASS.\");pm.execution.setNextRequest(null);}",
                  "else {pm.environment.unset(\"qa_pm_block_reason\");pm.environment.set(\"qa_pm_run_tag\",\"pm-\"+Date.now());[\"pm_cat\",\"pm_created_menu\",\"pm_station\"].forEach(k=>pm.environment.unset(k));}"
                ]
              }
            }
          ],
          "id": "f8544de8-be74-4a45-8209-39c0baa71aff",
          "description": "Gate for persistent menu mutations. qa_allow_persistent_menu_mutations=true required. FAIL/BLOCKED if disabled (correct safety behavior)."
        },
