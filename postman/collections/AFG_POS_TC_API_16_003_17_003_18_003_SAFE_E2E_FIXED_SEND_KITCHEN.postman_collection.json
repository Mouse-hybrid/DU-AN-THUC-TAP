        {
          "name": "TC_API_16_003 - GET Dashboard schema",
          "id": "a36e2b00-906c-4127-8a2c-6b5671c7110c",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pa_token_waiter}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/tables"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC_API_16_003: HTTP 200',()=>pm.response.to.have.status(200));",
                  "pm.test('TC_API_16_003: TableDashboardItem schema including nullable fields',()=>{",
                  " const a=pm.response.json();pm.expect(a).to.be.an('array').that.is.not.empty;",
                  " const uuid=/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
                  " a.forEach((t,i)=>{",
                  "  ['id','code','seats','status','current_session_id','guest_count','opened_at'].forEach(k=>pm.expect(t,'table #'+i+' missing '+k).to.have.property(k));",
                  "  pm.expect(t.id).to.be.a('string').that.matches(uuid);pm.expect(t.code).to.be.a('string');",
                  "  pm.expect(t.seats).to.be.a('number');pm.expect(Number.isInteger(t.seats),'seats integer').to.equal(true);",
                  "  pm.expect(t.status).to.be.a('string');",
                  "  if(t.current_session_id!==null)pm.expect(t.current_session_id).to.be.a('string');",
                  "  if(t.guest_count!==null){pm.expect(t.guest_count).to.be.a('number');pm.expect(Number.isInteger(t.guest_count)).to.equal(true);}",
                  "  if(t.opened_at!==null){pm.expect(t.opened_at).to.be.a('string');pm.expect(Number.isNaN(Date.parse(t.opened_at)),'opened_at date-time').to.equal(false);}",
                  " });",
                  "});"
                ]
              }
            }
          ]
        },
