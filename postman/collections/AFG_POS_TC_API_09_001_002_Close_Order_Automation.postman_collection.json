        {
          "name": "01 GET TABLE AVAILABLE",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pa_token_waiter}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/tables"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Tables 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Fresh AVAILABLE table selected (otherwise BLOCKED)\", () => { const result = pm.response.json(); pm.expect(result).to.be.an(\"array\"); pm.expect(result.some(t => t.status === \"AVAILABLE\"), \"No AVAILABLE table — QA fixture blocked\").to.equal(true); });",
                  "const result = pm.response.json();",
                  "const free = Array.isArray(result) ? result.find(t => t.status === 'AVAILABLE') : null;",
                  "if (pm.response.code !== 200 || !free) {",
                  "    pm.environment.unset('pa_table');",
                  "    console.warn('BLOCKED: No AVAILABLE table. Stop runner; restore an authorized QA fixture first.');",
                  "    pm.execution.setNextRequest(null);",
                  "} else { pm.environment.set('pa_table', free.id); }"
                ]
              }
            }
          ]
        },
