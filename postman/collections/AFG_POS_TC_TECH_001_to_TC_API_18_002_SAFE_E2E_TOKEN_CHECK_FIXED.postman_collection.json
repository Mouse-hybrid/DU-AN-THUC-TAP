                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"TokenResponse core fields and WAITER role\", () => {\n  const x = pm.response.json();\n  pm.expect(x).to.be.an(\"object\");\n  pm.expect(x.access_token, \"access_token\").to.be.a(\"string\").and.not.empty;\n  pm.expect(x.staff, \"staff\").to.be.an(\"object\");\n  pm.expect(x.staff.role, \"staff.role\").to.eql(\"WAITER\");\n  if (Object.prototype.hasOwnProperty.call(x, \"token_type\")) {\n    pm.expect(x.token_type, \"token_type\").to.be.a(\"string\").and.not.empty;\n  }\n  if (Object.prototype.hasOwnProperty.call(x, \"expires_in\")) {\n    pm.expect(x.expires_in, \"expires_in\").to.be.a(\"number\").and.above(0);\n  }\n});",
                  "if (!(pm.response.code===200)) {console.warn(\"BLOCKED: unexpected status at \"+pm.info.requestName);pm.execution.setNextRequest(null);}"
                ]
              }
            }
          ]
