  "info": {
    "_postman_id": "d1de5b87-a188-4903-bbf0-1d9cfe1c8601",
    "name": "AFG POS QA | SAFE E2E through TC_KDS_005_011 | 2026-10-09",
    "description": "One-off staging API automation. Tests KDS refire, replay, billing sum. Requires POS_STAGING env with baseUrl and password only; tokens and run_* variables created automatically. Use 1 iteration, 0 delay safe, but each run occupies a table; do not rerun without cleanup. Baseline discrepancies: TC_API_07_002 pre-SERVED vs QA data SENT allowed; payment callbacks and manager approvals NOT in OpenAPI. No secrets embedded.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01_ONE_SHOT_E2E_TO_KDS",
      "item": [
        {
          "name": "00 RUN GUARD - Reset run variables",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "One-time init: clears only run_* scoped variables. Run once with 1 iteration. This suite creates staging state. Do not rerun while earlier run occupies a table."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "[",
                  "  'run_table_id','run_session_id','run_order_id','run_item_id_1','run_item_id_2',",
                  "  'run_menu_id_1','run_menu_id_2','run_bill_before','run_bill_after',",
                  "  'run_refire_response','run_refire_key','run_pay_key','run_pay_first'",
                  "].forEach(k=>pm.environment.unset(k));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>{ pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
