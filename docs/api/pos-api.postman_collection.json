{
  "info": {
    "name": "NOVA POS API — QA",
    "description": "Chạy theo thứ tự (Run collection). Trước khi chạy: đặt biến baseUrl (staging) và password (xem SEED_PASSWORD trong backend/scripts/seed_dev_data.py, hoặc hỏi BE nếu staging đã đổi). Dữ liệu mẫu: chạy backend/scripts/seed_dev_data.py. Chi tiết payload: docs/api/qa-test-data.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run_id')) {",
          "  pm.collectionVariables.set('run_id', Date.now().toString().slice(-6));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "run_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Đăng nhập",
      "item": [
        {
          "name": "Login supervisor  [public]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token_supervisor', json.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login cashier  [public]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
