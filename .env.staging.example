POSTGRES_PASSWORD=replace-with-a-long-random-password
# Chuoi ngau nhien dai (vd: python -c "import secrets; print(secrets.token_urlsafe(48))").
# BAT BUOC phai set gia tri that khac default o moi trung ngoai development,
# app se tu crash khi khoi dong neu con la placeholder nay (xem app/core/config.py).
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Domain FE duoc phep goi API tu trinh duyet, cach nhau dau phay, KHONG dung "*".
# Vd khi FE chay local tro vao staging: http://localhost:5173
CORS_ALLOW_ORIGINS=
# Mat khau chung cho cac tai khoan test (admin/cashier/waiter/kitchen, qa2_*) do
# scripts/seed_dev_data.py tao moi lan deploy. Toi thieu 6 ky tu, khong dau cach,
# dau nhay hay '#'. De trong thi khong tao/doi tai khoan. Doi gia tri + deploy lai
# (hoac Re-run all jobs) = doi mat khau tat ca tai khoan test.
SEED_PASSWORD=
